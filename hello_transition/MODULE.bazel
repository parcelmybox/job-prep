module(
    name = "hello_transition_release",
    version = "1.0.0",
)

# Core C++ rules and OS/CPU platform constraint constants
bazel_dep(name = "rules_cc", version = "0.0.17")
bazel_dep(name = "platforms", version = "0.0.11")

# Hermetic Zig-based C++ cross-compiler (works natively on macOS Intel & Apple Silicon)
bazel_dep(name = "hermetic_cc_toolchain", version = "3.1.1")

toolchains = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains")
use_repo(toolchains, "zig_sdk")

# Register toolchains for ALL target platforms we plan to transition into
register_toolchains(
    "@zig_sdk//toolchain:linux_amd64_gnu.2.28",
    "@zig_sdk//toolchain:linux_arm64_gnu.2.28",
    "@zig_sdk//toolchain:darwin_arm64",
    "@zig_sdk//toolchain:darwin_amd64",
)
