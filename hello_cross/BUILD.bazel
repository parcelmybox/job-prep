load("@rules_cc//cc:defs.bzl", "cc_library")
load(":defs.bzl", "strict_cc_binary", "verify_binary_format")

platform(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
)

cc_library(
    name = "greeter_lib",
    srcs = ["greeter.cpp"],
    hdrs = ["greeter.h"],
)

strict_cc_binary(
    name = "hello_world",
    srcs = ["main.cpp"],
    deps = [":greeter_lib"],
)

verify_binary_format(
    name = "hello_format",
    target_bin = ":hello_world",
)
