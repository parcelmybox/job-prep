## 6. Hardened Kubernetes CI Build Pod Reference Manifest

```yaml
apiVersion: v1
kind: Pod
metadata:
  name: secure-bazel-ci-runner
  namespace: ci-runners
spec:
  # Enable isolated user namespace (maps container UID 0..65535 to unprivileged host UIDs)
  hostUsers: false
  restartPolicy: Never
  securityContext:
    runAsNonRoot: true
    runAsUser: 1000
    runAsGroup: 1000
    fsGroup: 1000
    seccompProfile:
      type: RuntimeDefault
  containers:
    - name: builder
      image: your-registry/bazel-build-env:latest
      securityContext:
        allowPrivilegeEscalation: false
        readOnlyRootFilesystem: true
        capabilities:
          drop: ["ALL"]
      resources:
        requests:
          cpu: "8"
          memory: "32Gi"
        limits:
          cpu: "8"
          memory: "32Gi"
      volumeMounts:
        - name: build-tmp
          mountPath: /tmp
        - name: build-shm
          mountPath: /dev/shm
  volumes:
    - name: build-tmp
      emptyDir:
        medium: Memory
        sizeLimit: 8Gi
    - name: build-shm
      emptyDir:
        medium: Memory
        sizeLimit: 2Gi
```
